{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Timecode Calc",
  "version": "0.1.0",
  "identifier": "com.fedeblock.timecodecalc",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Timecode Calc",
        "width": 1200,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Utility",
    "shortDescription": "Calculadora de timecode SMPTE",
    "copyright": "© 2026 Federico Block. MIT License with Attribution Requirement.",
    "licenseFile": "../LICENSE"
  }
}
